# ============================================================
# PowerHouse Gym Owner App — environment settings (.env.example)
# Copy this file to ".env" and adjust before real deployment.
# ============================================================

# SECRET_KEY — signs the login session cookie. Anyone with this key can
# forge a login, so use a long random value in production and never share it.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-in-production

# DATABASE_URL — where the SQLite database file lives.
# Default (when unset): backend/gym.db next to main.py.
# Example: DATABASE_URL=sqlite:////var/data/gym.db
# DATABASE_URL=sqlite:///./gym.db

# PORT — the port uvicorn listens on (set by your run command / host).
# Local default: 8000  →  uvicorn main:app --port 8000
PORT=8000

# COOKIE_SECURE — set to 1 to force the Secure flag on the session cookie.
# Note: the app already turns the Secure flag ON automatically whenever a
# request arrives over HTTPS (directly or via X-Forwarded-Proto from a
# proxy/load balancer), so on Render/HTTPS this is handled for you.
# Leave unset (0) for local http://localhost development.
# COOKIE_SECURE=1

# SHOW_DEMO_HINT — "true" (default) shows the demo login email/password in
# a hint box on the login page. Set to "false" on a public server so the
# demo credentials are not displayed to visitors.
SHOW_DEMO_HINT=true

# SEED_DEMO — "true" (default) creates the demo owner account
# (owner@powerhousegym.in / Gym@2026) and the 48 demo members the first
# time the app starts with an empty database. Set to "false" to run with
# no demo data and no demo reset button behaviour.
SEED_DEMO=true

# PAYMENT QR — not an environment variable: the UPI payment QR shown in
# the app's payment panel is the single file  backend/static/payment-qr.png
# (served in-app at GET /payment-qr.png, login required). The owner's real
# PhonePe QR is already installed there. To use a different QR, replace
# that one file — nothing else to change.
