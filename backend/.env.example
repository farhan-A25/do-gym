# ============================================================
# PowerHouse Gym Owner App — environment settings (.env.example)
# Copy this file to ".env" and adjust before real deployment.
# ============================================================

# SECRET_KEY — signs the login session cookie. Anyone with this key can
# forge a login, so use a long random value in production and never share it.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-in-production

# DATABASE_URL — where the SQLite database file lives.
# Default (when unset): backend/gym.db next to main.py.
# Example: DATABASE_URL=sqlite:////var/data/gym.db
# DATABASE_URL=sqlite:///./gym.db

# PORT — the port uvicorn listens on (set by your run command / host).
# Local default: 8000  →  uvicorn main:app --port 8000
PORT=8000

# COOKIE_SECURE — set to 1 to force the Secure flag on the session cookie.
# Note: the app already turns the Secure flag ON automatically whenever a
# request arrives over HTTPS (directly or via X-Forwarded-Proto from a
# proxy/load balancer), so on Render/HTTPS this is handled for you.
# Leave unset (0) for local http://localhost development.
# COOKIE_SECURE=1

# SHOW_DEMO_HINT — "true" (default) shows the demo login email/password in
# a hint box on the login page. Set to "false" on a public server so the
# demo credentials are not displayed to visitors.
SHOW_DEMO_HINT=true

# SEED_DEMO — "true" (default) creates the demo owner account
# (owner@powerhousegym.in / Gym@2026) and the 48 demo members the first
# time the app starts with an empty database. Set to "false" to run with
# no demo data and no demo reset button behaviour.
SEED_DEMO=true

# GOOGLE SIGN-IN — "Continue with Google" on the login/signup pages.
# Create an OAuth client in Google Cloud Console (see README, section
# "Google sign-in") and paste its credentials here. While either value is
# empty, Google sign-in stays OFF: the button is hidden and nothing breaks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# APP_BASE_URL — the public address of this app, used to build the Google
# redirect URI:  {APP_BASE_URL}/auth/google/callback
# That exact URI must be registered in the Google Cloud Console.
# Local default when unset: http://127.0.0.1:8000
# Example on Render: APP_BASE_URL=https://do-gym.onrender.com
# APP_BASE_URL=http://127.0.0.1:8000

# PAYMENT QR — not an environment variable: the UPI payment QR shown in
# the app's payment panel is the single file  backend/static/payment-qr.png
# (served in-app at GET /payment-qr.png, login required). The owner's real
# PhonePe QR is already installed there. To use a different QR, replace
# that one file — nothing else to change.

# RAZORPAY — OPTIONAL future online payment (dormant plumbing). While
# these are empty, the gateway stays OFF and nothing changes: owners
# pay Farhan in person (or by the static UPI QR above) and Farhan
# activates them from his Control page — see ADMIN_SECRET below and
# the README section "How owners actually pay". If all three are ever
# set, the order + webhook endpoints wake up and Razorpay can confirm
# payments on the server (the QR-only panel itself does not change).
# Webhook URL to register:  {APP_BASE_URL}/api/webhooks/razorpay
# Webhook events to enable: payment.captured and order.paid
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
<redacted>
ADMIN_SECRET=

# EMAIL OTP (canonical signup flow, step 2) — after signup, owners must
# enter a 6-digit OTP sent to their email before details/payment open.
# Real delivery needs SMTP. A Gmail App Password works:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# While these are empty, NO email is sent and the code is not exposed
# anywhere (it is only written to the server log as an event, never the
# code itself) — set all five before real signups go live.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# DEV_OTP_ECHO — LOCAL DEV / TESTS ONLY. When set to 1, OTP API
# responses include the live code so a developer can complete the
# signup flow without an SMTP server. NEVER set this in production:
# anyone signing up could read their code from the API response
# (by design in dev; a hole if live). Unset = off.
# DEV_OTP_ECHO=1
